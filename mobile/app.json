{
  "expo": {
    "name": "LotteryClock",
    "slug": "lotteryclock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lotteryclock",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.lotteryclock.app",
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "infoPlist": {
        "NSAlarmKitUsageDescription": "LotteryClock rings your gamble alarm at a random moment inside your window, even in Silent mode.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1435",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Geist-Regular.ttf",
            "./assets/fonts/Geist-Medium.ttf",
            "./assets/fonts/Geist-SemiBold.ttf",
            "./assets/fonts/Geist-Bold.ttf",
            "./assets/fonts/Geist-ExtraBold.ttf",
            "./assets/fonts/Geist-Black.ttf",
            "./assets/fonts/GeistMono-Regular.ttf",
            "./assets/fonts/GeistMono-Medium.ttf",
            "./assets/fonts/GeistMono-Bold.ttf",
            "./assets/fonts/GeistSerif-Regular.ttf",
            "./assets/fonts/GeistSerif-Triangle.ttf",
            "./assets/fonts/GeistSerif-Heart.ttf",
            "./assets/fonts/GeistPixel-Square.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
